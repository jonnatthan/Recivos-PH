{
    "name": "nexaph-pro",
    "version": "1.4.0",
    "description": "NexaPH Pro by NEXATECH - GestiÃ³n, FacturaciÃ³n y Recaudo de Propiedad Horizontal",
    "main": "main.js",
    "author": "NEXATECH",
    "license": "UNLICENSED",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win --publish never",
        "release": "electron-builder --win --publish always",
        "postinstall": "patch-package",
        "test": "node --test tests/*.test.js"
    },
    "dependencies": {
        "electron-updater": "^6.3.9",
        "google-auth-library": "^9.14.0",
        "nodemailer": "^6.9.15",
        "qrcode": "^1.5.4",
        "whatsapp-web.js": "1.34.7",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    },
    "devDependencies": {
        "electron": "^32.2.0",
        "electron-builder": "^25.1.8",
        "ffmpeg-static": "^5.3.0",
        "patch-package": "^8.0.1"
    },
    "build": {
        "appId": "co.nexatech.nexaph",
        "productName": "NexaPH Pro",
        "directories": {
            "output": "dist"
        },
        "files": [
            "**/*",
            "!dist/**",
            "!generador-licencias/**",
            "!documentacion/**",
            "!tests/**",
            "!*.log",
            "!*.md"
        ],
        "publish": [
            {
                "provider": "github",
                "owner": "jonnatthan",
                "repo": "nexaph-pro"
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "src/renderer/assets/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true
        }
    }
}
